{
   "name": "sh/shazbook",
   "description": "shazbook — simple social app",
   "type": "project",
   "require": {
      "php": ">=7.4",
      "codeigniter4/framework": "^4.5",
      "league/oauth2-google": "^4.0"
   },
   "autoload": {
      "psr-4": {
         "App\\": "app/"
      },
      "exclude-from-classmap": [
         "**/Database/Migrations/**"
      ]
   },
   "minimum-stability": "dev",
   "prefer-stable": true,
   "config": {
      "optimize-autoloader": true,
      "preferred-install": "dist",
      "sort-packages": true
   }
}
